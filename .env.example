# Tavily Hikari environment template. Copy to .env and fill in.
# Full reference: README.md "CLI Flags & Environment Variables".
PROXY_BIND=127.0.0.1
PROXY_PORT=8787
PROXY_DB_PATH=tavily_proxy.db
# Provider key bootstrap (optional; prefer admin UI in production)
TAVILY_API_KEYS=
SERPAPI_API_KEYS=
EXA_API_KEYS=
BRAVE_API_KEYS=
# Provider upstreams (defaults shown; override behind reverse proxy)
TAVILY_UPSTREAM=https://mcp.tavily.com/mcp
# TAVILY_USAGE_BASE=
SERPAPI_UPSTREAM=https://serpapi.com
SERPAPI_MCP_UPSTREAM=https://mcp.serpapi.com/mcp
EXA_UPSTREAM=https://api.exa.ai
BRAVE_UPSTREAM=https://api.search.brave.com
# Admin auth (choose one; see README "Admin Authentication")
# DEV_OPEN_ADMIN=true  # local dev only, never production
# ADMIN_AUTH_BUILTIN_ENABLED=true
# ADMIN_AUTH_BUILTIN_PASSWORD_HASH=